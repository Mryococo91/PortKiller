<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PortKiller.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PortKiller.Models"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
        <KeyboardAccelerator
            Key="F"
            Modifiers="Control"
            Invoked="OnSearchAccelerator" />
        <KeyboardAccelerator
            Key="E"
            Modifiers="Control"
            Invoked="OnExportAccelerator" />
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid Padding="16,8,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    x:Uid="SearchBox"
                    Grid.Column="0"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox
                    x:Name="ShowAllTcpCheckBox"
                    x:Uid="ShowAllTcpCheckBox"
                    Grid.Column="1"
                    IsChecked="{x:Bind ViewModel.ShowAllTcpConnections, Mode=TwoWay}"
                    VerticalAlignment="Center" />

                <ToggleSwitch
                    x:Name="AutoRefreshSwitch"
                    x:Uid="AutoRefreshSwitch"
                    Grid.Column="2"
                    IsOn="{x:Bind ViewModel.IsAutoRefreshEnabled, Mode=TwoWay}"
                    Toggled="OnAutoRefreshToggled"
                    VerticalAlignment="Center" />

                <Button
                    x:Name="RefreshButton"
                    x:Uid="RefreshButton"
                    Grid.Column="3"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Uid="RefreshButtonText" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="ExportButton"
                    x:Uid="ExportButton"
                    Grid.Column="4"
                    Command="{x:Bind ViewModel.ExportCsvCommand}"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE792;" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Uid="ExportButtonText" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="TerminateButton"
                    x:Uid="TerminateButton"
                    Grid.Column="5"
                    Command="{x:Bind ViewModel.TerminateSelectedCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Uid="TerminateButtonText" />
                    </StackPanel>
                </Button>

                <ComboBox
                    x:Name="LanguageBox"
                    x:Uid="LanguageBox"
                    Grid.Column="6"
                    MinWidth="128"
                    VerticalAlignment="Center"
                    SelectionChanged="OnLanguageChanged" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Uid="ElevationBanner"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsElevationBannerOpen, Mode=TwoWay}"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Uid="RelaunchAdminButton" Click="OnRelaunchAsAdminClicked" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Uid="ErrorBanner"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Closed="OnErrorClosed">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="RelaunchAdminButton"
                        Click="OnRelaunchAsAdminClicked"
                        Visibility="{x:Bind SelectionVisibility(ViewModel.ShowErrorAdminAction), Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}"
                Title="{x:Bind ViewModel.SuccessTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                Severity="Success"
                Closed="OnSuccessClosed" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            <ProgressRing
                Grid.Column="1"
                Width="18"
                Height="18"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="HeaderGrid"
                    Padding="12,4"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColPort" Width="72" />
                        <ColumnDefinition x:Name="ColProtocol" Width="80" />
                        <ColumnDefinition x:Name="ColState" Width="120" />
                        <ColumnDefinition x:Name="ColLocalAddress" Width="*" />
                        <ColumnDefinition x:Name="ColPid" Width="80" />
                        <ColumnDefinition x:Name="ColProcess" Width="180" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Command="{x:Bind ViewModel.SortByPortCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="0,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Uid="ColumnPort" FontWeight="SemiBold" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.PortSortGlyph, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.SortByProtocolCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="0,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Uid="ColumnProtocol" FontWeight="SemiBold" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.ProtocolSortGlyph, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        Command="{x:Bind ViewModel.SortByStateCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="0,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Uid="ColumnState" FontWeight="SemiBold" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.StateSortGlyph, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="3"
                        Command="{x:Bind ViewModel.SortByLocalAddressCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="0,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Uid="ColumnLocalAddress" FontWeight="SemiBold" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.LocalAddressSortGlyph, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="4"
                        Command="{x:Bind ViewModel.SortByPidCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="0,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Uid="ColumnPid" FontWeight="SemiBold" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.PidSortGlyph, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="5"
                        Command="{x:Bind ViewModel.SortByProcessCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="0,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Uid="ColumnProcess" FontWeight="SemiBold" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.ProcessSortGlyph, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ListView
                    x:Name="PortsList"
                    x:Uid="PortsList"
                    Grid.Row="1"
                    IsTabStop="True"
                    ItemsSource="{x:Bind ViewModel.VisibleEntries, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="36" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PortEntry">
                            <Grid x:Name="RowGrid" Padding="12,6" Loaded="OnRowGridLoaded">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Port}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ProtocolDisplay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind StateDisplay}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind LocalAddressDisplay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{x:Bind ProcessId}" />
                                <TextBlock
                                    Grid.Column="5"
                                    Text="{x:Bind ProcessNameDisplay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind ExecutablePath}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind EmptyVisibility(ViewModel.IsEmpty), Mode=OneWay}">
                    <FontIcon FontSize="32" Glyph="&#xE8F1;" />
                    <TextBlock
                        x:Uid="EmptyTitle"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Uid="EmptySubtitle"
                        HorizontalAlignment="Center"
                        Opacity="0.7" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Column="1"
                Width="320"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind SelectionVisibility(ViewModel.HasSelection), Mode=OneWay}">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="DetailsProcessTitle" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Uid="DetailsNameLabel" Opacity="0.7" />
                            <TextBlock
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Text="{x:Bind ViewModel.SelectedProcessName, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock x:Uid="DetailsPidLabel" Grid.Row="1" Opacity="0.7" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.SelectedProcessIdDisplay, Mode=OneWay}" />
                            <Button
                                x:Uid="CopyPidButton"
                                Grid.Row="1"
                                Grid.Column="2"
                                Click="OnCopyPidClicked" />

                            <TextBlock x:Uid="DetailsPathLabel" Grid.Row="2" Opacity="0.7" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.SelectedProcessPath, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Uid="CopyPathButton"
                                Grid.Row="2"
                                Grid.Column="2"
                                Click="OnCopyPathClicked"
                                IsEnabled="{x:Bind ViewModel.HasSelectedProcessPath, Mode=OneWay}" />

                            <TextBlock x:Uid="DetailsStartedLabel" Grid.Row="3" Opacity="0.7" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Text="{x:Bind ViewModel.SelectedProcessStartTime, Mode=OneWay}" />
                        </Grid>

                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind PortsHeader(ViewModel.SelectedProcessPortCount), Mode=OneWay}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedProcessPorts, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PortEntry">
                                    <Grid Margin="0,0,0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Port}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProtocolDisplay}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind StateDisplay}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Opacity="0.75"
                                            Text="{x:Bind RemoteEndpointDisplay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind RemoteEndpointDisplay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
