<Project>
  <PropertyGroup>
    <!-- Single source of truth for app / MSI / ZIP naming. -->
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Company>Port Killer</Company>
    <Product>Port Killer</Product>
    <Authors>Port Killer contributors</Authors>
    <Copyright>Copyright © Port Killer contributors</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>
</Project>
